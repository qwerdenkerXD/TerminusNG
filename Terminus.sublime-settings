{
    // the default config, either a single config name or a platform
    // specific dict
    "default_config": {
        "linux": null,    // login shell
        "osx": null,      // login shell
        "windows": "Command Prompt"
    },
    // a list of available shells to execute
    "shell_configs": [
        {
            "name": "Bash",
            "cmd": ["bash", "-i", "-l"],
            "env": {},
            "enable": true,
            "platforms": ["linux", "osx"]
        },
        {
            "name": "Zsh",
            "cmd": ["zsh", "-i", "-l"],
            "env": {},
            "enable": true,
            "platforms": ["linux", "osx"]
        },
        {
            "name": "Command Prompt",
            "cmd": "cmd.exe",
            "env": {},
            "enable": true,
            "platforms": ["windows"]
        },
        {
            "name": "PowerShell Core",
            "cmd": "pwsh.exe",
            "env": {},
            "enable": true,
            "platforms": ["windows"]
        },
        {
            "name": "PowerShell",
            "cmd": "powershell.exe",
            "env": {},
            "enable": true,
            "platforms": ["windows"]
        },
        {
            "name": "Cmder",
            "cmd": ["cmd.exe", "/k", "%CMDER_ROOT%\\vendor\\init.bat"],
            "env": {},
            "enable": false,
            "platforms": ["windows"]
        },
        {
            "name": "WSL Login Shell",
            "cmd": "wsl.exe",
            "env": {},
            "enable": true,
            "platforms": ["windows"]
        }
    ],

    "256color": true,

    // brighten bold text
    "brighten_bold_text": true,

    // the default TERM variable of unix system. Possible values are
    // "linux", "xterm", "xterm-16color" and "xterm-256color".
    // However, please aware that not all xterm features are supported.
    // setting this to "linux" also switches the home and end keys to the linux
    // console codes instead of the xterm ones.
    // a TERM passed in the "env" of a shell config or of `terminus_open` wins over
    // this setting, and is checked against the same list of values on every platform,
    // Windows included. an unsupported value makes the terminal refuse to open.
    // on Windows a "wsl.exe" command is given TERM=xterm-256color and has TERM,
    // COLORTERM and TERM_PROGRAM shared into the distribution through WSLENV.
    "unix_term": "xterm-256color",

    // the default LANG variable of unix system.
    "unix_lang": "en_US.UTF-8",

    // number of lines kept in scrollback history
    // decreasing this value may improve performance
    "scrollback_history_size": 10000,

    // set a minimum or maximum terminal width in characters
    "min_columns": 20,
    "max_columns": 500,

    // set a minimum terminal height in lines. a one line terminal makes full screen
    // programs such as vim, less or htop unusable, so keep this above 1.
    "min_rows": 4,

    // open a new terminal in the working directory the current terminal's shell
    // last reported through OSC 7, instead of in the first project folder. this
    // needs the shell to report it, see "shell integration" in the readme. a
    // directory this side of the pty cannot reach, such as one reported by a wsl
    // or an ssh shell, is ignored.
    "follow_shell_cwd": true,

    // underline the hyperlinks a program marks with OSC 8, show their target when
    // one is hovered and open it when the popup or the context menu entry is
    // clicked. the text of such a link says nothing about where it points, so the
    // popup shows the target itself. only http, https and file targets are ever
    // opened, anything else is refused. with this off a link is drawn as ordinary
    // text and only the plain urls in the text stay clickable, as they always were.
    "hyperlinks": true,

    // put a marker in the gutter on the row every prompt begins on, red when the
    // command run from that prompt exited non zero. this needs the shell to report
    // its prompt boundaries with OSC 133, see "shell integration" in the readme;
    // without that nothing is ever marked. only the gutter is touched, the terminal
    // output itself keeps the colors the program chose.
    "prompt_markers": true,

    // force the terminal size
    "size": [null, null],

    // Windows and Linux only
    // use ctrl+c to copy
    // use ctrl+v to paste  (use ctrl+alt+v to send ctrl+v instead)
    // use ctrl+pagedown/pageup to change tabs
    "natural_keyboard": true,

    // Terminus sends all keybinds of the form `ctrl+[a-z]` to the terminal process
    // directly. Windows and Linux users sometimes may want to preserve some of such
    // keybinds. (only keybinds listed below are supported, open an issue for a specific
    // keybind if it is not in the list)
    "preserve_keys" : [
        // "ctrl+k"   // there are a number of shortcuts with "ctrl+k" prefix.
        // "ctrl+p"   // to show Go to Anything
    ],

    // the name of the theme
    // the theme could be either "classic", "adaptive", "user" or any predefined themes
    // listed in the command `Terminus Utilities: Select Theme`.
    // For Sublime Text before 4096, the adaptive theme will fallback to the classic theme.
    "theme": "adaptive",

    // change `theme` to "user" if you want to use customized theme
    // see https://www.sublimetext.com/docs/3/color_schemes.html#colors for the
    // available colors
    "user_theme_colors": {
        // "background": "#262626",
        // "foreground": "#ffffff",
        // "caret": "white",
        // "block_caret": "white",
        // "selection": "#444444",
        // "selection_foreground": "#ffffff"
        // "black": "#000000",
        // "red": "#cd0000",
        // "green": "#00cd00",
        // "brown": "#cdcd00",
        // "blue": "#0000ee",
        // "magenta": "#cd00cd",
        // "cyan": "#00cdcd",
        // "white": "#e5e5e5",
        // "light_black": "#7f7f7f",
        // "light_red": "#ff0000",
        // "light_green": "#00ff00",
        // "light_brown": "#ffff00",
        // "light_blue": "#5c5cff",
        // "light_magenta": "#ff00ff",
        // "light_cyan": "#00ffff",
        // "light_white": "#ffffff"
    },

    "view_settings": {
        // these are extra view settings which are passed to the terminus_view,
        // you could change settings like "font_face", "font_size" and paddings.
        // you should also specify these settings in the syntax specfic file
        // "Terminus View.sublime-settings".
    },

    // reactivate terminals when window starts
    "reactivate_terminals": true,

    "debug": false
}
